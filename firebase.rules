rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Competition data is public to read. All writes go through protected server routes.
    match /teams/{teamId} {
      allow read: if true;
      allow write: if false;
    }
    match /matches/{matchId} {
      allow read: if true;
      allow write: if false;
    }
    // No public access to private admin/user documents.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
